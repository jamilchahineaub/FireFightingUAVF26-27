  <!-- propulsion, one MulticopterMotorModel per prop. command: gz.msgs.Actuators on
       /cl415/command/motor_speed, velocity[0] = left, velocity[1] = right, in rad/s -->
  <xacro:macro name="motor_plugins">
    <gazebo>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>cl415</robotNamespace>
        <jointName>left_propeller_joint</jointName>
        <linkName>left_propeller</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>890.118</maxRotVelocity>
        <motorConstant>4.2079e-05</motorConstant>
        <momentConstant>0.0299455</momentConstant>
        <commandSubTopic>command/motor_speed</commandSubTopic>
        <motorNumber>0</motorNumber>
        <rotorDragCoefficient>0.0001</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
    </gazebo>
    <gazebo>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>cl415</robotNamespace>
        <jointName>right_propeller_joint</jointName>
        <linkName>right_propeller</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>890.118</maxRotVelocity>
        <motorConstant>4.2079e-05</motorConstant>
        <momentConstant>0.0299455</momentConstant>
        <commandSubTopic>command/motor_speed</commandSubTopic>
        <motorNumber>1</motorNumber>
        <rotorDragCoefficient>0.0001</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
    </gazebo>
  </xacro:macro>

</robot>
