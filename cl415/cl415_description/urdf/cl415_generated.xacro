  <xacro:macro name="inertial_water_tank" params="tank">
    <xacro:if value="${tank == 'full'}">
      <inertial>
        <origin xyz="-0.0694257 3.0847e-18 -0.187676" rpy="0 0 0"/>
        <mass value="3.25"/>
        <inertia ixx="0.00927936" ixy="0" ixz="0" iyy="0.0140512" iyz="0" izz="0.0174169"/>
      </inertial>
    </xacro:if>
    <xacro:if value="${tank == 'empty'}">
      <inertial>
        <origin xyz="-0.0694257 1.94229e-17 -0.187676" rpy="0 0 0"/>
        <mass value="0.25"/>
        <inertia ixx="0.00118536" ixy="0" ixz="0" iyy="0.00163559" iyz="0" izz="0.00197235"/>
      </inertial>
    </xacro:if>
  </xacro:macro>

  <!-- servo pid gains: p = I wn^2, d = 2 zeta wn I, i = p wn / 25, wn = 80 rad/s, zeta = 1.0,
       I = inertia about the hinge axis; torque capped at 0.5 N m like a 5 kg cm servo -->
  <xacro:property name="servo_left_aileron_p" value="0.1691"/>  <!-- hinge inertia 2.64e-05 kg m^2 -->
  <xacro:property name="servo_left_aileron_d" value="0.004228"/>
  <xacro:property name="servo_left_aileron_i" value="0.5411"/>
  <xacro:property name="servo_right_aileron_p" value="0.1691"/>  <!-- hinge inertia 2.64e-05 kg m^2 -->
  <xacro:property name="servo_right_aileron_d" value="0.004228"/>
  <xacro:property name="servo_right_aileron_i" value="0.5411"/>
  <xacro:property name="servo_elevator_p" value="0.5155"/>  <!-- hinge inertia 8.06e-05 kg m^2 -->
  <xacro:property name="servo_elevator_d" value="0.01289"/>
  <xacro:property name="servo_elevator_i" value="1.65"/>
  <xacro:property name="servo_rudder_p" value="0.4659"/>  <!-- hinge inertia 7.28e-05 kg m^2 -->
  <xacro:property name="servo_rudder_d" value="0.01165"/>
  <xacro:property name="servo_rudder_i" value="1.491"/>
  <xacro:property name="servo_torque_max" value="0.5"/>

